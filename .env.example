# ── Mistral AI Configuration ──────────────────────────────
# Get your API key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# ── Groq API Configuration (Recommended for Render Free Tier) ──────────
# Enables ultra-fast Whisper transcription (1-2s) and drops RAM usage to <70MB!
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Faster-Whisper Model Configuration (Local Fallback) ──
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# ── Server Port (Optional, default: 8505) ─────────────────
PORT=8505

